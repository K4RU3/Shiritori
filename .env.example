# Shiritori v4 環境変数サンプル
# 実際の値を設定のうえ、.env にリネームしてください。
# (.env は .gitignore 済みのためコミットされません)

# [必須] Discordボットトークン
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# [任意] データディレクトリ(省略時 ./data)。Dockerでは /data を使用
# DATA_DIR=./data

# [任意/Docker] docker compose がホスト側で待ち受けるポート(省略時 8080)
# SHIRITORI_PORT=8080

# [任意] Web機能(以下の3つがすべて揃った場合のみ有効)
# 待ち受けアドレス
WEB_BIND=0.0.0.0:8080
# ユーザー遷移用の公開アドレス
WEB_PUBLIC_URL=https://dict.example.com
# 管理画面のパスワード
WEB_PASSWORD=change-me
